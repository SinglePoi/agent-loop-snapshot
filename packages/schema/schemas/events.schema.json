{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-loop-snapshot.dev/schema/0.1.0/events.schema.json",
  "title": "Agent Loop Snapshot Event Envelope",
  "description": "An append-only event envelope. Known event types receive payload validation; unknown event types remain readable as opaque events and must not be executed.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "event_id",
    "parent_ids",
    "sequence",
    "type",
    "timestamp",
    "monotonic_offset_ms",
    "actor",
    "payload",
    "security"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "event_id": {
      "$ref": "#/$defs/eventId"
    },
    "parent_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventId"
      },
      "uniqueItems": true
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_offset_ms": {
      "type": "number",
      "minimum": 0
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "type": "object"
        }
      ]
    },
    "security": {
      "$ref": "#/$defs/security"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.started"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/runStartedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.completed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/runCompletedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.failed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/runFailedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model.requested"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/modelRequestedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model.completed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/modelCompletedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model.failed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/modelFailedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.requested"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/toolRequestedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.completed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/toolCompletedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.failed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/toolFailedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision.recorded"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decisionRecordedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "state.changed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/stateChangedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "checkpoint.created"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/checkpointCreatedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "verification.completed"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/verificationCompletedPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^cp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifactReference": {
      "type": "object",
      "required": ["schema_version", "digest", "media_type", "byte_length"],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "preview": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": ["string", "number", "boolean", "null"]
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "runtimeDescriptor": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "kind": {
          "enum": ["model", "tool", "validation", "policy", "runtime", "unknown"]
        },
        "details": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": ["side_effect", "redactions"],
      "properties": {
        "side_effect": {
          "enum": ["read_only", "workspace_write", "external_write", "destructive"]
        },
        "redactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/redaction"
          }
        }
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["category", "path", "strategy"],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "enum": ["mask", "reference", "remove", "custom"]
        }
      },
      "additionalProperties": true
    },
    "payloadObject": {
      "type": "object"
    },
    "runStartedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["runtime"],
          "properties": {
            "runtime": {
              "$ref": "#/$defs/runtimeDescriptor"
            },
            "input": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "runCompletedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["final_state_hash"],
          "properties": {
            "final_state_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "output": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "runFailedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["error"],
          "properties": {
            "error": {
              "$ref": "#/$defs/error"
            }
          }
        }
      ]
    },
    "modelRequestedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["correlation_key", "model", "input"],
          "properties": {
            "correlation_key": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "modelCompletedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["correlation_key", "output"],
          "properties": {
            "correlation_key": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "modelFailedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["correlation_key", "error", "attempt"],
          "properties": {
            "correlation_key": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "$ref": "#/$defs/error"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "toolRequestedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["correlation_key", "tool", "arguments"],
          "properties": {
            "correlation_key": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "toolCompletedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["correlation_key", "output"],
          "properties": {
            "correlation_key": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "toolFailedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["correlation_key", "error", "attempt"],
          "properties": {
            "correlation_key": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "$ref": "#/$defs/error"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "decisionRecordedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["decision", "basis_summary", "success_conditions"],
          "properties": {
            "decision": {
              "type": "string",
              "minLength": 1
            },
            "basis_summary": {
              "type": "string",
              "minLength": 1
            },
            "success_conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "stateChangedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["path", "operation"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "enum": ["set", "merge", "delete", "append"]
            },
            "value": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "checkpointCreatedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["checkpoint_id", "last_event_id", "sequence", "state_hash"],
          "properties": {
            "checkpoint_id": {
              "$ref": "#/$defs/checkpointId"
            },
            "last_event_id": {
              "$ref": "#/$defs/eventId"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "state_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "verificationCompletedPayload": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "$ref": "#/$defs/payloadObject",
          "type": "object",
          "required": ["verifier", "result"],
          "properties": {
            "verifier": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "enum": ["passed", "failed"]
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
