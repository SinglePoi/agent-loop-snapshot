{
  "name": "@agent-loop-snapshot/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Validate, inspect, and visualize Agent Loop Snapshot artifacts.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SinglePoi/agent-loop-snapshot.git"
  },
  "author": "Agent Loop Snapshot contributors",
  "homepage": "https://github.com/SinglePoi/agent-loop-snapshot",
  "bugs": {
    "url": "https://github.com/SinglePoi/agent-loop-snapshot/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "bin": {
    "alsnap": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@agent-loop-snapshot/graph": "workspace:*",
    "@agent-loop-snapshot/otel-import": "workspace:*",
    "@agent-loop-snapshot/recorder": "workspace:*",
    "@agent-loop-snapshot/replay": "workspace:*",
    "@agent-loop-snapshot/schema": "workspace:*",
    "@agent-loop-snapshot/trace": "workspace:*"
  }
}
